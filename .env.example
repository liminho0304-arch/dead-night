# Qloo hackathon API key (sent as the X-Api-Key header)
QLOO_API_KEY=
# Optional: defaults to the hackathon host
QLOO_API_URL=https://hackathon.api.qloo.com
# The agent's model. Claude is used if its key is set, otherwise Gemini (free key from
# https://aistudio.google.com/apikey). With neither, a deterministic offline planner runs
# over the same Qloo tools.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
