# Qloo hackathon API key (sent as the X-Api-Key header)
QLOO_API_KEY=
# Optional: defaults to the hackathon host
QLOO_API_URL=https://hackathon.api.qloo.com
# Claude. Without it, Dead Night runs a deterministic offline planner over the same Qloo tools.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5
